# Copy to .env and replace the required local values. Never commit .env.
NODE_ENV=development
API_PORT=8787
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_agent
JWT_SECRET=replace-this-with-a-long-random-secret

# Optional provider and webhook credentials:
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# RETELL_WEBHOOK_SECRET=your-retell-webhook-secret
